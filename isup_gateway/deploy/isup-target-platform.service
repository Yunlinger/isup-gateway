[Unit]
Description=ISUP target cam platform
Wants=network-online.target isup-target-media.service
After=network-online.target isup-target-media.service

[Service]
WorkingDirectory=/opt/isup-target
EnvironmentFile=/opt/isup-target/platform.env
ExecStart=/usr/bin/python3 -u /opt/isup-target/saas_main.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
