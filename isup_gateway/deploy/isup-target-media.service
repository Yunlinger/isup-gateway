[Unit]
Description=ISUP target platform MediaMTX
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/isup-target
ExecStart=/opt/isup-target/mediamtx/mediamtx /opt/isup-target/mediamtx/mediamtx.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
