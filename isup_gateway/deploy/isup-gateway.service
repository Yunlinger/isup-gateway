[Unit]
Description=ISUP live camera gateway
Wants=network-online.target
After=network-online.target saascam-full.service

[Service]
Type=simple
WorkingDirectory=/root/isup-gateway
ExecStart=/root/isup-gateway/.venv/bin/python -u -m isup_gateway --config /root/isup-gateway/config.json --status-file /root/isup-gateway/status.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=75
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
